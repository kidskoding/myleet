---
// Three-segment route: two climbed rungs (filled) and two open ones.
interface Props {
  class?: string;
}
const { class: cls = "brand-mark" } = Astro.props;
---

<svg class={cls} viewBox="0 0 24 24" aria-hidden="true"
  ><path d="M3.5 19 L10 12.5 L14 14.5 L20.5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  ></path><circle cx="3.5" cy="19" r="2.2" fill="currentColor"></circle><circle cx="10" cy="12.5" r="2.2" fill="currentColor"
  ></circle><circle cx="14" cy="14.5" r="2.2" fill="var(--ground)" stroke="currentColor" stroke-width="1.6"></circle><circle
    cx="20.5"
    cy="5"
    r="2.2"
    fill="var(--ground)"
    stroke="currentColor"
    stroke-width="1.6"></circle></svg
>
