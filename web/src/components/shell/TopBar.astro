---
import { ROUTES } from "../../lib/routes";
import Icon from "../Icon.astro";
import type { IconName } from "../../lib/ui/icons";
import BrandMark from "./BrandMark.astro";

export type NavKey = "today" | "plan" | "learn" | "companies" | "mock" | "progress";
interface Props {
  nav?: NavKey | undefined;
}
const { nav } = Astro.props;
// Same icons as the mobile TabBar
const links: { key: NavKey; href: string; label: string; icon: IconName }[] = [
  { key: "today", href: ROUTES.today, label: "Today", icon: "sunrise" },
  { key: "plan", href: ROUTES.plan, label: "Plan", icon: "calendar-days" },
  { key: "learn", href: ROUTES.learn, label: "Learn", icon: "map" },
  { key: "mock", href: ROUTES.mock, label: "Mock", icon: "timer" },
  { key: "companies", href: ROUTES.companies, label: "Companies", icon: "building-2" },
  { key: "progress", href: ROUTES.progress, label: "Progress", icon: "trending-up" },
];
---

<header class="topbar" transition:persist="topbar" transition:animate="none">
  <a class="brand" href={ROUTES.home} aria-label="myleet, home"><BrandMark /><span class="brand-word">myleet</span></a>
  <nav class="nav" aria-label="Primary">
    {links.map((l) => <a href={l.href} data-nav={l.key} aria-current={nav === l.key ? "page" : undefined}><Icon name={l.icon} />{l.label}</a>)}
  </nav>
  <div class="topbar-end">
    <button class="search-trigger" type="button" data-open-palette aria-label="Search and commands" aria-keyshortcuts="Control+K Meta+K">
      <Icon name="search" /><span class="label">Search</span><kbd data-mod-k>Ctrl K</kbd>
    </button>
    <div class="account">
      <a class="streak" href={ROUTES.progress} data-streak hidden aria-current={nav === "progress" ? "page" : undefined}>
        <Icon name="calendar-check" /><span class="num" data-streak-num>0</span><span class="unit" data-streak-unit>days</span>
      </a>
      <a class="btn btn-ghost btn-sm when-out" href={ROUTES.signin} data-signin-link="in">Sign in</a>
      <a class="btn btn-primary btn-sm when-out" href={`${ROUTES.signin}?mode=signup`} data-signin-link="up">Sign up for free</a>
      <button class="avatar-btn when-in" type="button" data-account-menu aria-haspopup="menu" aria-expanded="false" aria-controls="account-menu" aria-label="Account and settings">
        <span class="avatar" data-avatar></span>
      </button>
    </div>
  </div>
</header>
