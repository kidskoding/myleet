---
// Old playlist URLs (`/playlists/001_google`) go to the company page.
import { buildCatalog } from "../../lib/build-catalog";
import { companyHref } from "../../lib/routes";

export function getStaticPaths() {
  return buildCatalog().playlists.map((playlist) => ({ params: { id: playlist.id } }));
}

return Astro.redirect(companyHref(Astro.params.id ?? ""), 301);
---
