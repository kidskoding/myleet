---
import Base from "../layouts/Base.astro";
---

<Base title="Today" nav="today" noindex description="Your next problem, why it's on your list, and today's plan">
  <div class="page today" data-today>
    <div class="today-layout">
      <div data-today-main aria-busy="true" aria-label="Loading today">
        <div class="skel" style="height:34px;width:min(320px,80%)"></div>
        <div class="skel" style="height:22px;width:min(440px,90%);margin-top:12px"></div>
        <div class="panel nextup-skel">
          <div class="skel" style="height:22px;width:160px"></div><div class="skel" style="height:44px;width:70%"></div><div class="skel" style="height:16px;width:50%"></div>
        </div>
        <div class="panel queue-skel"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
      </div>
      <aside class="side-notes" data-today-aside aria-label="Plan">
        <section class="panel"><div class="skel" style="height:20px;width:60%"></div><div class="skel" style="height:44px;width:40%;margin-top:16px"></div><div class="skel" style="height:60px;margin-top:16px"></div></section>
        <section class="panel"><div class="skel" style="height:20px;width:55%"></div><div class="skel" style="height:56px;margin-top:16px"></div></section>
        <section class="panel"><div class="skel" style="height:20px;width:40%"></div><div class="skel" style="height:32px;margin-top:16px"></div></section>
      </aside>
    </div>
  </div>
</Base>

<style is:global>
  html:has(.gate-split), html:has(.gate-split) body { overflow-x: clip; }
  /* Guest Today: the invitation beside a framed preview of the personal Today it unlocks */
  .gate-split { display: grid; gap: var(--space-10); align-items: center; }
  .gate-split .gate { max-width: none; margin-top: var(--space-6); }
  .gate-split .gate-steps { grid-template-columns: 1fr; gap: var(--space-4); }
  .gate-split .gate-steps li { border: 0; background: none; padding: 0; }
  @media (min-width: 1000px) {
    /* Stripe/Linear-style hero sized by width: text beside a larger product preview that always stays whole,
       with a full-bleed glow behind it */
    .gate-split { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(var(--space-8), 4vw, var(--space-16)); padding-top: var(--space-6); position: relative; }
    .gate-split::before { content: ""; position: absolute; z-index: -1; inset: -20% -50vw; background: radial-gradient(48% 55% at 72% 50%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 70%); pointer-events: none; }
    .gate-split .gate h1 { font-size: clamp(2.75rem, 1.6rem + 2.4vw, 4rem); }
  }
  .gate-eg-today { margin: 0; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); box-shadow: 0 24px 60px -24px color-mix(in srgb, var(--ground) 80%, transparent), var(--shadow-md); overflow: hidden; }
  .gate-eg-today .eg-window { display: flex; align-items: center; gap: 6px; padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--line); background: var(--surface-sunk); }
  .gate-eg-today .eg-window i { width: 10px; height: 10px; border-radius: 50%; }
  .gate-eg-today .eg-window i.r { background: var(--ctp-red); } .gate-eg-today .eg-window i.y { background: var(--ctp-yellow); } .gate-eg-today .eg-window i.g { background: var(--ctp-green); }
  .gate-eg-today .eg-window span { margin-left: var(--space-2); font: 500 var(--label-size) var(--font-label); letter-spacing: var(--label-track); color: var(--ink-3); }
  .gate-eg-today .eg-body { padding: var(--space-5) var(--space-6) var(--space-4); display: grid; gap: var(--space-3); }
  .gate-eg-today .eg-hello { font-size: var(--text-md); font-weight: 700; color: var(--ink); }
  .gate-eg-today .eg-note { color: var(--ink-2); font-size: var(--text-sm); line-height: 1.55; }
  .greet p strong, .gate-eg-today .eg-note strong { color: var(--ink); font-weight: 650; }
  .gate-eg-today .eg-ready-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2); }
  .gate-eg-today .eg-ready-h { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-base); font-weight: 700; color: var(--ink); }
  .gate-eg-today .eg-ready-h .co-logo { width: 20px !important; height: 20px !important; vertical-align: 0 !important; }
  .gate-eg-today .eg-ready-top strong { font-family: var(--font-label); font-size: var(--text-base); color: var(--ink); }
  .gate-eg-today .eg-bar { height: 5px; border-radius: 99px; background: var(--surface-sunk); overflow: hidden; }
  .gate-eg-today .eg-bar span { display: block; height: 100%; background: var(--accent); border-radius: inherit; }
  .gate-eg-today .eg-queue { list-style: none; padding: 0; margin: 0; display: grid; }
  .gate-eg-today .eg-queue li { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4); padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .gate-eg-today .eg-queue li > div { display: grid; gap: 2px; min-width: 0; }
  .gate-eg-today .eg-queue strong { font-size: var(--text-sm); font-weight: 650; }
  .gate-eg-today .eg-queue li span { font-size: var(--text-xs); color: var(--ink-3); line-height: 1.45; }
  .gate-eg-today .eg-tag { flex: none; font: 600 var(--text-xs) var(--font-ui) !important; padding: 2px 8px; border-radius: 99px; }
  .gate-eg-today .eg-tag.due { color: var(--due); background: var(--due-soft); }
  .gate-eg-today .eg-tag.weak { color: var(--weak); background: var(--weak-soft); }
  .gate-eg-today .eg-tag.new { color: var(--new); background: var(--new-soft); }

  .today-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: var(--space-10); align-items: start; }
  .today-layout.is-first-run { grid-template-columns: 1fr; }
  .today-layout.is-first-run aside { display: none; }
  .today .greet p { margin-top: var(--space-3); color: var(--ink-2); font-size: var(--text-lede); }
  .today .greet .countdown-inline { display: none; }

  /* The one featured (L2) surface on Today */
  .today .nextup { margin-top: var(--space-8); padding: var(--space-8) var(--space-8) var(--space-6); display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: var(--space-6) var(--space-8); }
  .today .nextup .tags { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .today .nextup h2 { margin-top: var(--space-4); font-size: clamp(2rem, 1.2rem + 1.8vw, 2.75rem); font-weight: 720; letter-spacing: var(--track-hero); line-height: 1.02; font-variation-settings: "wdth" 84; }
  .today .nextup h2 a { text-decoration: none; }
  .today .nextup .meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-top: var(--space-4); color: var(--ink-2); font-size: var(--text-sm); align-items: center; }
  .today .nextup .meta .icon { width: 16px; height: 16px; display: inline; vertical-align: -3px; color: var(--ink-3); }
  .today .nextup .why { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: var(--space-3) var(--space-4); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .today .nextup .why p { color: var(--ink-2); font-size: var(--text-sm); max-width: 52ch; }
  .today .nextup .rail { align-self: center; }
  .today .nextup .rail .cap { margin-top: var(--space-2); font-size: var(--text-xs); color: var(--ink-2); }
  .today .nextup-skel { margin-top: var(--space-8); padding: var(--space-6) var(--space-8); display: grid; gap: 12px; }
  .today .queue-skel { margin-top: var(--space-10); padding: var(--space-4); display: grid; gap: 16px; }
  .today .queue-skel .skel { height: 40px; }

  .today .group { margin-top: var(--space-10); }
  .today .group .section-head h2 { font-size: var(--text-sec); }

  .today aside { padding-top: var(--space-2); }
  .today aside h2 { font-size: var(--text-sec); }
  .today aside .section-head { margin: 0; align-items: center; }
  .today .pace { margin-top: var(--space-4); display: grid; gap: var(--space-3); font-size: var(--text-sm); }
  .today .pace-row { display: grid; grid-template-columns: 1fr auto; gap: var(--space-1) var(--space-3); align-items: center; }
  .today .pace-row .bar { grid-column: 1 / -1; }
  .today .countdown { margin-top: var(--space-4); display: flex; align-items: baseline; gap: var(--space-3); }
  .today .pace-cause { grid-column: 1 / -1; font-size: var(--text-xs); color: var(--ink-3); }
  .today .plan-note { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--ink-2); }
  .today .why-lead { color: var(--ink); font-weight: 600; }

  .today .week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; margin-top: var(--space-4); list-style: none; padding: 0; }
  .today .day { font-size: var(--text-xs); color: var(--ink-3); font-weight: 600; }
  .today .day a { display: grid; justify-items: center; gap: 6px; color: inherit; text-decoration: none; border-radius: var(--radius-sm); }
  .today .day a:hover .n { box-shadow: inset 0 0 0 1px var(--ink-3); }
  .today .day.is-today a:hover .n { box-shadow: inset 0 0 0 1.5px var(--accent); }
  .today .day .n { width: 100%; height: 40px; display: grid; place-items: center; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--ctp-text) 5%, transparent); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); font-family: var(--font-label); font-size: var(--text-sm); font-weight: 600; font-variant-numeric: tabular-nums slashed-zero; }
  .today .day.is-today { color: var(--ink); }
  .today .day.is-today .n { background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px var(--accent); }
  .today .day.light .n { color: var(--ink-3); background: transparent; }
  .today .budget { margin-top: var(--space-3); }
  .today .greet .replan { margin-top: var(--space-3); }
  .today .wsmini { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: grid; }
  .today .wsmini li { display: grid; gap: var(--space-2); padding: var(--space-3) 0; }
  .today .wsmini li + li { border-top: 1px solid var(--line); }
  .today .wsmini .t { display: flex; justify-content: space-between; gap: var(--space-2); align-items: center; font-weight: 650; font-size: var(--text-sm); }
  .today .wsmini .t a { color: var(--ink); text-decoration: none; }
  .today .wsmini .t a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .today .wsmini p { font-size: var(--text-sm); color: var(--ink-2); }
  .today .wsmini .btn { justify-self: start; height: auto; min-height: 32px; white-space: normal; text-align: left; }
  .today aside .fc { margin-top: var(--space-4); }
  .today aside .fc-row { grid-template-columns: minmax(0, 1fr) auto; }
  .today aside .fc-row .fc-bar { grid-column: 1 / -1; grid-row: 2; }
  .today aside .fineprint { margin-top: var(--space-3); }
  .today .ready { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .today .ready-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .today .ready-head h3 { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-md); font-weight: 680; letter-spacing: var(--track-head); color: var(--ink); }
  .today .ready-head .ready-logo { width: 20px !important; height: 20px !important; }
  .today .ready-pct { font-family: var(--font-label); font-size: var(--text-md); font-weight: 650; letter-spacing: var(--track-num); font-variant-numeric: tabular-nums; color: var(--ink); }
  .today .ready-line { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--ink-2); line-height: var(--leading-snug, 1.4); }
  .today .ready-bar { margin-top: var(--space-3); height: 8px; border-radius: var(--radius-pill); background: var(--surface-sunk); overflow: hidden; }
  .today .ready-bar > span { display: block; height: 100%; min-width: 4px; border-radius: inherit; background: var(--pass-solid); transition: width var(--dur-base) var(--ease-spring); }
  .today .section-head > .link { white-space: nowrap; }
  .today .goal-ready { list-style: none; margin: var(--space-4) 0 0; padding: var(--space-4) 0 0; border-top: 1px solid var(--line); display: grid; gap: var(--space-4); }
  .today .goal-ready li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: var(--space-3); }
  .today .goal-ready .gr-name { display: inline-flex; align-items: center; gap: var(--space-2); min-width: 0; font-size: var(--text-sm); font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .today .goal-ready .ready-logo { width: 18px !important; height: 18px !important; flex: none; }
  .today .goal-ready .gr-n { font-size: var(--text-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .today .goal-ready .gr-n b { color: var(--ink); font-weight: 650; }
  .today .goal-ready .ready-bar { grid-column: 1 / -1; margin-top: var(--space-2); height: 6px; }

  .today .greet .quiet { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--ink-2); }
  .today .greet .meta { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--ink-3); }
  .today .foryou { list-style: none; margin: var(--space-8) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-4); }
  .today .foryou li { display: grid; gap: var(--space-2); align-content: start; padding: var(--space-5); }
  .today .foryou-label { font-size: var(--text-xs); font-weight: 600; color: var(--accent); }
  .today .foryou-title { font-size: var(--text-base); font-weight: 650; text-decoration: none; }
  .today .foryou-title:hover { text-decoration: underline; }
  .today .foryou p { font-size: var(--text-sm); color: var(--ink-2); }

  .today .checkin ol { margin-top: var(--space-3); }
  .today .checkin .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .today .checkin p { margin-top: var(--space-2); color: var(--ink-2); font-size: var(--text-sm); }
  .today .checkin .qrow { padding: var(--space-2) var(--space-3); min-height: 48px; gap: var(--space-3); grid-template-columns: minmax(0, 1fr) auto; }
  .today .checkin .qrow .ladder-cell, .today .checkin .qrow .diff { display: none; }
  .today .checkin .qrow .title { font-size: var(--text-sm); }

  @media (max-width: 1100px) {
    .today-layout { grid-template-columns: 1fr; }
    .today .nextup { grid-template-columns: 1fr; }
    .today .nextup .rail { max-width: 320px; }
    .today aside { grid-template-columns: repeat(2, 1fr); align-items: start; }
    .today aside > section:first-child { grid-row: span 2; }
  }
  @media (max-width: 760px) {
    .today aside { grid-template-columns: 1fr; }
    .today aside > section:first-child { grid-row: auto; }
    .today .greet .countdown-inline { display: block; margin-top: var(--space-1); color: var(--ink); font-weight: 600; font-size: var(--text-sm); }
    .today .nextup { grid-template-columns: 1fr; padding: var(--space-5); gap: var(--space-5); }
    .today .nextup h2 { font-size: 2.125rem; }
    /* Start stays above the fold: the actions come before the ladder */
    .today .nextup .rail { order: 3; max-width: 220px; }
    .today .nextup .rail .guide-lbl { display: none; }
    .today .nextup .why { order: 2; grid-template-columns: 1fr 1fr; }
    .today .nextup .why p { grid-column: 1 / -1; }
    .today .nextup .why .btn { width: 100%; }
  }
</style>

<script>
  import "../scripts/today";
</script>
