---
import "@fontsource-variable/jetbrains-mono/index.css";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { ACCENT_NAMES, ACCENTS, FLAVOR_NAMES, SITE_FLAVOR } from "../lib/flavors";
import { ROUTES } from "../lib/routes";


const targets = Array.from({ length: 11 }, (_, i) => 10 + i * 5);
const sections = [
  ["goals", "Your goals"],
  ["profile", "Profile"],
  ["appearance", "Appearance"],
  ["editor", "Editor"],
  ["practice", "Practice"],
  ["schedule", "Practice schedule"],
  ["leetcode", "LeetCode"],
  ["reminders", "Reminders"],
  ["privacy", "Public profile"],
] as const;
const account = [
  ["signin", "Sign-in methods"],
  ["sessions", "Sessions"],
] as const;
---

<Base title="Settings" noindex gated description="Profile, appearance, editor, practice, reminders, sign-in methods, sessions and your data">
  <div class="page settings" data-settings>
    <div class="set-head">
      <h1>Settings</h1>
      <span class="saved" data-saved aria-live="polite"><span class="when-in">Changes save as you go</span><span class="when-out">Saved on this device</span></span>
    </div>
    <div class="set">
      <nav class="side" aria-label="Settings sections">
        {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        <span class="sep when-in"></span>
        {account.map(([id, label]) => <a class="when-in" href={`#${id}`}>{label}</a>)}
        <a href="#data">Your data</a>
      </nav>
      <div>
        <section class="grp" aria-labelledby="goals">
          <h2 id="goals">Your goals</h2>
          <p class="lede grp-lede">What your plan works towards. Today, the plan and the reason shown on each problem all come from these</p>
          <div class="panel goals-panel" data-goals-settings></div>
        </section>

        <section class="grp" aria-labelledby="profile">
          <h2 id="profile">Profile</h2>
          <div class="panel signedout when-out">
            <p>Your progress and settings are saved in this browser. Sign in to sync them across devices and keep your existing progress</p>
            <button class="btn btn-primary" type="button" data-signin>Keep my progress</button>
          </div>
          <div class="panel when-in">
            <div class="row">
              <div><div class="lbl">Photo</div><div class="desc">From GitHub or Google, or your initials</div></div>
              <div class="ctl"><span class="avatar avatar-lg" data-set-avatar></span></div>
            </div>
            <div class="row">
              <div><label class="lbl" for="set-name">Display name</label><div class="desc">Shown on your public profile, if it's on</div></div>
              <div class="ctl wide"><input id="set-name" class="input" autocomplete="name" maxlength="60" data-set-name /></div>
            </div>
            <div class="row">
              <div><label class="lbl" for="set-user">Username</label><div class="desc">Lowercase letters, numbers and dashes. It's also your profile link</div></div>
              <div class="ctl wide">
                <div style="width:100%">
                  <div class="prefix"><span>/u/</span><input id="set-user" class="input" spellcheck="false" autocapitalize="off" maxlength="30" aria-describedby="set-user-msg" data-set-user /></div>
                  <p class="field-msg" id="set-user-msg" role="status" data-user-msg></p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="grp" aria-labelledby="appearance">
          <h2 id="appearance">Appearance</h2>
          <div class="panel">
            <div class="row"><div><div class="lbl">Catppuccin {FLAVOR_NAMES[SITE_FLAVOR]}</div><div class="desc">Dark theme with your choice of accent color</div></div></div>
            <div class="row stack">
              <div><div class="lbl" id="ac-l">Accent <b data-accent-name>Mauve</b></div><div class="desc">Buttons, links, focus, your current level and the heatmap. Tags keep their own colors</div></div>
              <div>
                <div class="accents" role="radiogroup" aria-labelledby="ac-l">
                  {ACCENTS.map((a) => (
                    <label title={ACCENT_NAMES[a]} data-accent-dot={a}>
                      <input type="radio" name="accent" value={a} aria-label={ACCENT_NAMES[a]} />
                      <span class="dot" style={`--r: var(--ctp-${a})`}><Icon name="check" /></span>
                    </label>
                  ))}
                </div>
                <p class="ac-note" data-accent-note>Pick the color for buttons, links and your practice progress</p>
                <div class="ac-preview" aria-hidden="true"><span class="btn btn-primary btn-sm">Start</span><span class="ac-link">Edit plan</span><span class="tag tag-new">New topic</span></div>
              </div>
            </div>
            <div class="row">
              <div><label class="lbl" for="set-font">Interface font</label><div class="desc">Menus, buttons and titles</div></div>
              <div class="ctl"><select id="set-font" class="input" style="width:180px" data-pref="font"><option value="archivo">Geist</option><option value="mono">JetBrains Mono</option></select></div>
            </div>
            <div class="row">
              <div><label class="lbl" for="set-read-font">Reading font</label><div class="desc">Notes and problem statements</div></div>
              <div class="ctl"><select id="set-read-font" class="input" style="width:180px" data-pref="readFont"><option value="literata">Literata</option><option value="mono">JetBrains Mono</option></select></div>
            </div>
            <div class="row">
              <div><div class="lbl" id="rm-l">Reduce motion</div><div class="desc">Off follows your system setting. On also stops the level-up animation and the highlight after a pass</div></div>
              <div class="ctl"><label class="switch"><input type="checkbox" data-pref="reduceMotion" aria-labelledby="rm-l" /></label></div>
            </div>
            <p class="credit">Colors are <a href="https://catppuccin.com" rel="noopener">Catppuccin</a>, MIT licensed</p>
          </div>
        </section>

        <section class="grp" aria-labelledby="editor">
          <h2 id="editor">Editor</h2>
          <div class="panel">
            <div class="row">
              <div><div class="lbl" id="vim-l">Vim keybindings</div><div class="desc">Normal, insert and visual modes. <kbd>esc</kbd> leaves insert mode; nothing in myleet is bound to a bare <kbd>esc</kbd> while you type</div></div>
              <div class="ctl"><label class="switch"><input type="checkbox" data-pref="editor.vim" aria-labelledby="vim-l" /></label></div>
            </div>
            <div class="row">
              <div><div class="lbl" id="fs-l">Font size</div><div class="desc">Code only. Statements follow your browser's text size</div></div>
              <div class="ctl">
                <div class="stepper" role="group" aria-labelledby="fs-l">
                  <button type="button" data-step="editor.fontSize" data-by="-1" aria-label="Smaller"><Icon name="minus" /></button><output data-out="editor.fontSize">14</output><button type="button" data-step="editor.fontSize" data-by="1" aria-label="Larger"><Icon name="plus" /></button>
                </div>
              </div>
            </div>
            <div class="row">
              <div>
                <div class="lbl" id="lig-l">Ligatures</div><div class="desc">Join <code>-&gt;</code>, <code>&lt;=</code>, <code>!=</code> into single glyphs</div>
                <div class="codeprev" data-codeprev aria-hidden="true"><span class="k">def</span> <span class="d">valid</span>(n: <span class="b">int</span>) -&gt; <span class="b">bool</span>:  <span class="k">return</span> n &lt;= <span class="n">9</span> <span class="k">and</span> n != <span class="n">0</span></div>
              </div>
              <div class="ctl"><label class="switch"><input type="checkbox" data-pref="editor.ligatures" aria-labelledby="lig-l" /></label></div>
            </div>
            <div class="row">
              <div><div class="lbl" id="mm-l">Minimap</div><div class="desc">A scaled outline of your file on the right edge</div></div>
              <div class="ctl"><label class="switch"><input type="checkbox" data-pref="editor.minimap" aria-labelledby="mm-l" /></label></div>
            </div>
            <div class="row">
              <div><label class="lbl" for="set-indent">Indent</label></div>
              <div class="ctl"><select id="set-indent" class="input" style="width:160px" data-pref="editor.indent"><option value="4">4 spaces</option><option value="2">2 spaces</option></select></div>
            </div>
            <div class="row">
              <div><div class="lbl" id="fos-l">Format on save</div><div class="desc">Runs ruff format on <kbd data-mod>Ctrl</kbd><kbd>S</kbd></div></div>
              <div class="ctl"><label class="switch"><input type="checkbox" data-pref="editor.formatOnSave" aria-labelledby="fos-l" /></label></div>
            </div>
            <div class="row">
              <div><div class="lbl" id="ros-l">Run tests on save</div><div class="desc">Off by default so you can choose when to run tests. Disabled during mock interviews</div></div>
              <div class="ctl"><label class="switch"><input type="checkbox" data-pref="editor.runOnSave" aria-labelledby="ros-l" /></label></div>
            </div>
          </div>
        </section>

        <section class="grp" aria-labelledby="practice">
          <h2 id="practice">Practice</h2>
          <div class="panel">
            <div class="row">
              <div><div class="lbl" id="npd-l">New problems per day</div><div class="desc">Reviews come first. Use "Time today" on Today to reduce new problems for a single day</div></div>
              <div class="ctl">
                <div class="stepper" role="group" aria-labelledby="npd-l">
                  <button type="button" data-step="newPerDay" data-by="-1" aria-label="Fewer"><Icon name="minus" /></button><output data-out="newPerDay">3</output><button type="button" data-step="newPerDay" data-by="1" aria-label="More"><Icon name="plus" /></button>
                </div>
              </div>
            </div>
            <div class="row">
              <div><div class="lbl">Time targets</div><div class="desc">A pass only counts as clean inside this time. The default is <strong>25 minutes</strong> at every difficulty</div></div>
              <div class="ctl">
                {
                  (["easy", "medium", "hard"] as const).map((d) => (
                    <span class="tt">
                      <span class="text-small text-muted">{d[0]?.toUpperCase() + d.slice(1)}</span>
                      <select class="input" aria-label={`${d} target`} data-pref={`timeTargets.${d}`}>
                        {targets.map((m) => <option value={m}>{m} min</option>)}
                      </select>
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </section>

        <section class="grp" aria-labelledby="schedule">
          <h2 id="schedule">Practice schedule</h2>
          <p class="lede grp-lede">When sessions can go and how long each one runs. <a class="link" href={ROUTES.plan}>Open the plan</a></p>
          <div class="panel" data-plan-settings></div>
        </section>

        <section class="grp" aria-labelledby="leetcode">
          <h2 id="leetcode">LeetCode</h2>
          <p class="lede grp-lede">Connect your public profile so the plan skips what you already know</p>
          <div class="panel" data-lc-settings></div>
        </section>

        <section class="grp" aria-labelledby="reminders">
          <h2 id="reminders">Reminders</h2>
          <div class="panel" data-reminder-settings></div>
        </section>

        <section class="grp" aria-labelledby="privacy">
          <h2 id="privacy">Public profile</h2>
          <div class="panel">
            <div class="row">
              <div>
                <div class="lbl" id="pub-l">Make my profile public</div>
                <div class="desc">Shows your name, streak, mastered and practiced counts and the practice heatmap at <code data-profile-path>/u/you</code>. Never your code, attempts, notes, hints, weak spots or interview date</div>
                <p class="desc when-out" style="margin-top:var(--space-2)">Sign in to turn this on</p>
              </div>
              <div class="ctl"><label class="switch"><input type="checkbox" data-pref="publicProfile" aria-labelledby="pub-l" /></label></div>
            </div>
          </div>
        </section>

        <section class="grp when-in" aria-labelledby="signin">
          <h2 id="signin">Sign-in methods</h2>
          <div class="panel" data-methods><div class="meth"><span class="skel" style="height:28px;width:28px"></span><span class="skel" style="height:16px;width:50%"></span></div><div class="meth"><span class="skel" style="height:28px;width:28px"></span><span class="skel" style="height:16px;width:40%"></span></div></div>
        </section>

        <section class="grp when-in" aria-labelledby="sessions">
          <h2 id="sessions">Sessions</h2>
          <div class="panel" data-sessions><div class="sess"><span class="skel" style="height:16px;width:50%"></span></div><div class="sess"><span class="skel" style="height:16px;width:40%"></span></div></div>
        </section>

        <section class="grp" aria-labelledby="data">
          <h2 id="data">Your data</h2>
          <div class="panel">
            <div class="row when-in">
              <div><div class="lbl">Export your account</div><div class="desc">Profile, sign-in methods, settings, sessions and synced progress, as one JSON file</div></div>
              <div class="ctl"><a class="btn btn-secondary btn-sm" href="/api/me/export" download><Icon name="download" />Download JSON</a></div>
            </div>
            <div class="row">
              <div><div class="lbl">Export progress</div><div class="desc">This browser's practice history as <code>events.jsonl</code>, the same file the myleet CLI keeps</div></div>
              <div class="ctl"><button class="btn btn-secondary btn-sm" type="button" data-export-local><Icon name="download" />Download events.jsonl</button></div>
            </div>
            <div class="row">
              <div><div class="lbl" id="imp-l">Import</div><div class="desc">Merge an <code>events.jsonl</code> from the CLI or another browser, or an account export. Nothing is overwritten, and the two histories are merged</div></div>
              <div class="ctl"><label class="btn btn-ghost btn-sm file-btn"><Icon name="upload" />Choose file<input type="file" accept=".jsonl,.json,.ndjson,application/json" data-import aria-labelledby="imp-l" /></label></div>
            </div>
          </div>
        </section>

        <section class="danger when-in" aria-labelledby="del">
          <div><h2 id="del">Delete account</h2><p>Deletes your account, sign-in methods, sessions and synced progress from our servers. This browser keeps a local copy unless you also clear it</p></div>
          <button class="btn btn-quiet-danger" type="button" data-delete>Delete account</button>
        </section>
      </div>
    </div>
  </div>
  <aside class="drawer" data-av-drawer role="dialog" aria-modal="false" aria-labelledby="dr-h" hidden></aside>
</Base>

<style is:global>
  .settings .set { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--space-12); align-items: start; margin-top: var(--space-8); }
  .settings .set-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .settings .side { position: sticky; top: calc(var(--topbar-h) + var(--space-6)); display: grid; gap: 2px; }
  .settings .side a { display: block; padding: 7px var(--space-3); font-size: var(--text-sm); font-weight: 550; color: var(--ink-2); text-decoration: none; border-radius: var(--radius-sm); transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .settings .side a:hover { background: var(--surface-sunk); color: var(--ink); }
  .settings .side a[aria-current="true"] { background: var(--surface); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  .settings .side .sep { height: 1px; background: var(--line); margin: var(--space-2) var(--space-3); }
  .settings .saved { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-sm); color: var(--ink-3); transition: color var(--dur-fast) var(--ease-out); }
  .settings .saved.ok { color: var(--pass); }
  .settings .saved.err { color: var(--fail); }
  .settings .grp { margin-top: var(--space-10); }
  .settings .grp:first-child { margin-top: 0; }
  .settings .grp > h2 { font-size: var(--text-md); margin-bottom: var(--space-3); scroll-margin-top: calc(var(--topbar-h) + var(--space-6)); }
  .settings .grp .panel { padding: 0 var(--space-6); }
  .settings .goals-panel { padding: var(--space-5) var(--space-6) !important; }
  .settings .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px); gap: var(--space-3) var(--space-8); align-items: center; padding: var(--space-4) 0; }
  .settings .row + .row { border-top: 1px solid var(--line); }
  .settings .row[hidden] + .row { border-top: 1px solid var(--line); }
  .settings .row .lbl { font-weight: 600; font-size: var(--text-sm); }
  .settings .row .desc { font-size: var(--text-sm); color: var(--ink-3); margin-top: 2px; }
  .settings .row .ctl { justify-self: end; display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; justify-content: flex-end; }
  .settings .row .ctl.wide { justify-self: stretch; }
  .settings .input { height: 36px; font-size: var(--text-sm); }
  .settings .tt { display: inline-flex; gap: 6px; align-items: center; white-space: nowrap; }
  .settings .tt select { width: auto; }
  .settings .prefix { display: flex; width: 100%; }
  .settings .prefix span { display: grid; place-items: center; padding: 0 var(--space-3); border: 1px solid var(--control-edge); border-right: 0; border-radius: var(--radius-sm) 0 0 var(--radius-sm); background: var(--surface-sunk); font-size: var(--text-sm); color: var(--ink-3); }
  .settings .prefix .input { border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .settings .field-msg { font-size: var(--text-xs); margin-top: var(--space-1); min-height: 1.2em; font-weight: 600; display: flex; gap: 4px; align-items: center; }
  .settings .field-msg.ok { color: var(--pass); }
  .settings .field-msg.bad { color: var(--fail); }
  .settings .field-msg .icon { width: 14px; height: 14px; }
  .settings .avatar-lg { width: 44px; height: 44px; font-size: var(--text-sm); background: var(--accent-soft); color: var(--accent); }
  .settings .row.stack { grid-template-columns: 1fr; }
  .settings .row .lbl b { font-weight: 600; color: var(--ink-2); }
  /* Flavor cards: each swatch is drawn from that flavor's own palette, whatever flavor is showing. */
  .settings .flavors { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-2); }
  .settings .flavors label { position: relative; display: grid; gap: 6px; padding: 6px 6px var(--space-2); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font-size: var(--text-xs); font-weight: 600; cursor: pointer; text-align: center; transition: border-color var(--dur-fast) var(--ease-out); }
  .settings .flavors label:hover { border-color: var(--ink-3); }
  .settings .flavors label:has(input:checked) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .settings .flavors label:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .settings .flavors input, .settings .accents input, .settings .seg-radio input { position: absolute; opacity: 0; pointer-events: none; }
  .settings .flavors small { display: block; font-weight: 500; color: var(--ink-3); font-size: var(--text-2xs); }
  .settings .sw { height: 52px; border-radius: 4px; display: grid; grid-template-columns: 34% 1fr; overflow: hidden; outline: 1px solid var(--line-strong); outline-offset: -1px; }
  .settings .sw > span:first-child { background: var(--m); }
  .settings .sw > span:last-child { background: var(--b); display: grid; align-content: center; gap: 5px; padding: 0 8px; }
  .settings .sw i { display: block; height: 4px; border-radius: 2px; background: var(--t); width: 80%; }
  .settings .sw i:nth-child(2) { width: 55%; background: var(--a); }
  .settings .sw i:nth-child(3) { width: 65%; opacity: 0.5; }
  .settings .sw.sys { grid-template-columns: 1fr 1fr; }
  .settings .sw.sys > span:first-child { background: var(--ctp-latte-base); }
  .settings .sw.sys > span:last-child { background: var(--ctp-base); }
  .settings .seg-radio label { position: relative; display: grid; place-items: center; height: 28px; padding: 0 var(--space-3); font-size: var(--text-xs); font-weight: 600; color: var(--ink-2); border-radius: 4px; cursor: pointer; transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .settings .seg-radio label:hover { color: var(--ink); }
  .settings .seg-radio label:has(input:checked) { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-sm); }
  .settings .seg-radio label:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 1px; }
  @media (pointer: coarse) { .settings .seg-radio label { height: 40px; } }
  /* Accent dots: the outer ring is the palette colour (the name people know), the centre is the fill this
     flavor actually applies, so in Latte a pale accent shows its deeper button colour before you pick it. */
  .settings .accents { display: grid; grid-template-columns: repeat(7, 36px); gap: var(--space-2) var(--space-3); }
  .settings .accents label { position: relative; width: 36px; height: 36px; display: grid; place-items: center; cursor: pointer; border-radius: 50%; }
  .settings .accents .dot { width: 28px; height: 28px; border-radius: 50%; background: var(--f, var(--r)); box-shadow: inset 0 0 0 6px var(--r), inset 0 0 0 7px color-mix(in srgb, var(--ink) 14%, transparent); display: grid; place-items: center; color: var(--o, var(--on-accent)); transition: transform var(--dur-press) var(--ease-out); }
  .settings .accents label:active .dot { transform: scale(0.94); }
  .settings .accents label:has(input:checked) { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--f, var(--r)); }
  .settings .accents label:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 4px; }
  .settings .accents .icon { width: 16px; height: 16px; opacity: 0; }
  .settings .accents label:has(input:checked) .icon { opacity: 1; }
  .settings .ac-note { font-size: var(--text-xs); color: var(--ink-3); margin-top: var(--space-3); max-width: 60ch; }
  .settings .ac-preview { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; margin-top: var(--space-4); }
  .settings .ac-link { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; font-size: var(--text-sm); }
  .settings .credit { padding: var(--space-3) 0 var(--space-4); border-top: 1px solid var(--line); font-size: var(--text-xs); color: var(--ink-3); }
  .settings .credit a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 760px) {
    .settings .flavors { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .settings .accents { grid-template-columns: repeat(7, minmax(0, 44px)); gap: var(--space-1) 0; justify-content: space-between; }
    .settings .accents label { width: 100%; height: 44px; }
  }
  .settings .codeprev { margin-top: var(--space-2); font-family: var(--font-code); line-height: 1.6; background: var(--code-bg); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-3) var(--space-4); white-space: pre; overflow-x: auto; font-size: 14px; }
  .settings .codeprev.no-lig { font-variant-ligatures: none; }
  .settings .codeprev .k { color: var(--syn-keyword); } .settings .codeprev .d { color: var(--syn-def); font-weight: 600; } .settings .codeprev .b { color: var(--syn-builtin); } .settings .codeprev .n { color: var(--syn-number); }
  .settings .meth { display: grid; grid-template-columns: 28px 1fr auto; gap: var(--space-3); align-items: center; padding: var(--space-4) 0; }
  .settings .meth + .meth, .settings .meth + .row { border-top: 1px solid var(--line); }
