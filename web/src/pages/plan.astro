---
import Base from "../layouts/Base.astro";
---

<Base title="Plan" nav="plan" noindex description="Your practice schedule, with sessions that fit your available hours and explanations for each problem">
  <div class="page plan" data-plan>
    <div class="plan-loading" aria-busy="true" aria-label="Loading your plan">
      <div class="skel" style="height:16px;width:60px"></div>
      <div class="skel" style="height:32px;width:260px;margin-top:16px"></div>
      <div class="skel" style="height:20px;width:520px;max-width:100%;margin-top:12px"></div>
      <div class="skel" style="height:32px;width:100%;margin-top:32px"></div>
      <div class="panel" style="margin-top:12px;padding:var(--space-4)"><div class="skel" style="height:460px"></div></div>
      <div class="route"><div class="panel panel-pad"><div class="skel" style="height:16px;width:140px"></div><div class="skel" style="height:92px;margin-top:20px"></div></div><div class="panel panel-pad" style="display:grid;gap:14px"><div class="skel" style="height:16px;width:160px"></div><div class="skel" style="height:28px"></div><div class="skel" style="height:28px"></div><div class="skel" style="height:28px"></div></div></div>
    </div>
  </div>
  <aside class="drawer" data-av-drawer role="dialog" aria-modal="false" aria-labelledby="dr-h" hidden></aside>
  <p class="visually-hidden" id="plan-sr" aria-live="assertive"></p>
  <p class="visually-hidden" id="ses-hint">Enter opens the session. Space picks it up to move; arrows choose a window</p>
</Base>

<style is:global>
  .plan { position: relative; }
  .plan .back { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-sm); font-weight: 600; color: var(--ink-2); text-decoration: none; }
  .plan .back:hover { color: var(--ink); }
  .plan .back .icon { width: 16px; height: 16px; }
  .plan-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-6); margin-top: var(--space-3); flex-wrap: wrap; }
  .plan-head h1 { font-size: var(--text-xl); }
  .plan-head .lede { margin-top: var(--space-2); color: var(--ink-2); font-size: var(--text-md); font-variation-settings: "wdth" 95; max-width: 60ch; }
  .plan-head .lede b { color: var(--ink); font-weight: 650; }
  .plan .head-actions { display: flex; gap: var(--space-2); }
  .plan > .replan, .plan .plan-flow > .replan { margin-top: var(--space-6); }

  /* toolbar */
  .plan .week-sec { margin-top: var(--space-8); }
  /* One control height (32px, 40px+ on touch), one radius (--radius-sm) across the bar. */
  .cal-bar { --ctl: 32px; display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-3); }
  @media (pointer: coarse) { .cal-bar { --ctl: 40px; } }
  .cal-bar h2 { font-size: var(--text-md); line-height: var(--ctl); font-variant-numeric: tabular-nums; min-width: 8.5em; }
  .cal-bar .nav2 { display: inline-flex; gap: 2px; }
  .cal-bar .nav2 .icon-btn { width: var(--ctl); height: var(--ctl); }
  .cal-bar .nav2 .icon-btn:disabled { opacity: .35; pointer-events: none; }
  .cal-bar .todaybtn { --h: var(--ctl); }
  .cal-bar .budget { display: flex; align-items: center; gap: var(--space-4); margin-left: auto; font-size: var(--text-sm); color: var(--ink-2); flex-wrap: wrap; }
  .cal-bar .budget .bl { font-weight: 650; color: var(--ink); }
  .cal-bar .budget .bg { display: inline-flex; align-items: center; gap: var(--space-2); }
  .cal-bar .stepper { height: var(--ctl); }
  .cal-bar .stepper button { width: calc(var(--ctl) - 2px); height: calc(var(--ctl) - 2px); border-radius: calc(var(--radius-sm) - 1px); transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .cal-bar .stepper button:disabled { opacity: .35; cursor: default; background: none; }
  .cal-bar .stepper output { width: auto; min-width: 7ch; white-space: nowrap; font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  /* Segmented control: the thumb shares the pressed button's grid cell, then glides (plan.ts placeThumb). */
  .cal-bar .seg { display: inline-grid; grid-auto-flow: column; height: var(--ctl); padding: 2px; box-shadow: inset 0 0 0 1px var(--line); }
  .cal-bar .seg button { position: relative; z-index: 1; grid-row: 1; height: auto; padding: 0 var(--space-3); }
  .cal-bar .seg button:nth-of-type(1) { grid-column: 1; }
  .cal-bar .seg button:nth-of-type(2) { grid-column: 2; }
  .cal-bar .seg button:nth-of-type(3) { grid-column: 3; }
  .cal-bar .seg [aria-pressed="true"] { background: none; box-shadow: none; }
  .cal-bar .seg-thumb { grid-row: 1; grid-column: var(--on, 1); border-radius: calc(var(--radius-sm) - 2px); background: color-mix(in srgb, var(--ctp-text) 7%, var(--surface)); box-shadow: inset 0 0 0 1px var(--line-strong), var(--shadow-sm); }
  .plan .live { font-size: var(--text-sm); color: var(--ink-2); margin: 0 0 var(--space-3); }
  .plan .live:empty { display: none; }
  .plan .live strong { color: var(--ink); font-weight: 650; }
  .plan .legend { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: var(--text-xs); color: var(--ink-3); font-weight: 550; }
  .plan .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .plan .legend i { width: 9px; height: 9px; border-radius: var(--radius-xs); flex: none; }
  .plan .legend .hint { margin-left: auto; }
  .plan .cal-legend { margin-top: var(--space-3); }
  .lg-mock { background: var(--mix-mock); transform: rotate(45deg) scale(.85); }
  .lg-check { border: 1.5px solid var(--ink-2); border-radius: 50% !important; }
  .lg-off { border-bottom: 1.5px dashed var(--control-edge); border-radius: 0 !important; height: 5px !important; }

  /* week grid */
  .week-cal { padding: 0; overflow: clip; }
  .wk { display: grid; grid-template-columns: 52px repeat(var(--cols, 7), minmax(0, 1fr)); }
  .wk-head { position: sticky; top: var(--topbar-h); z-index: 4; background: var(--surface); border-bottom: 1px solid var(--line); }
  .dh { padding: var(--space-3) var(--space-2) var(--space-2); display: grid; gap: 4px; border-left: 1px solid var(--line); min-width: 0; }
  .dh-top { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
  .dh .dn { display: flex; align-items: baseline; gap: 6px; font-size: var(--text-sm); font-weight: 600; color: var(--ink-2); }
  .dh .dn b { font-size: var(--text-md); font-weight: 700; color: var(--ink); font-variation-settings: "wdth" 75; font-variant-numeric: tabular-nums; }
  .dh.today { background: var(--accent-soft); }
  .dh.today .dn, .dh.today .dn b { color: var(--accent); }
  .dh .load { display: flex; align-items: center; gap: 6px; min-height: 16px; font-size: var(--text-xs); color: var(--ink-3); font-weight: 600; font-variation-settings: "wdth" 75; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dh .load .bar { flex: 1; height: 4px; }
  .dh .load .bar span { background: var(--ink-2); transition: width var(--dur-base) var(--ease-spring); }
  .dh.today .load .bar span { background: var(--accent); }
  .dh.off .load { color: var(--ink-2); }
  .dh .daymenu { width: 26px; height: 26px; margin: -4px -4px 0 0; }
  .wk-body { position: relative; }
  .ruler { position: relative; }
  .ruler span { position: absolute; right: 8px; transform: translateY(-50%); font-size: var(--text-2xs); font-weight: 600; color: var(--ink-3); font-variation-settings: "wdth" 75; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ruler span.edge { transform: translateY(3px); }
  .hl { position: absolute; left: 52px; right: 0; height: 0; border-top: 1px solid var(--line); pointer-events: none; }
  .hl.half { border-top-style: dashed; border-color: color-mix(in srgb, var(--line) 70%, transparent); }
  .fold { position: absolute; left: 0; right: 0; z-index: 1; display: flex; align-items: center; padding-left: 60px; font-size: var(--text-xs); color: var(--ink-3); background: var(--surface-sunk); border-block: 1px solid var(--line); pointer-events: none; }
  .col { position: relative; border-left: 1px solid var(--line); min-width: 0; container-type: inline-size; }
  /* Narrow columns (the inspector open, 4-day view) keep the title and drop the repeated minutes. */
  @container (max-width: 120px) { .col .ses.short .mm { display: none; } }
  .col > ol { list-style: none; margin: 0; padding: 0; }
  .col.today { background: color-mix(in srgb, var(--accent) 3%, transparent); }
  .col.drop-ok { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .wk-empty { display: grid; justify-items: center; gap: var(--space-2); padding: var(--space-16) var(--space-6); text-align: center; }
  .wk-empty h3 { font-size: var(--text-md); }
  .wk-empty p { color: var(--ink-2); font-size: var(--text-sm); max-width: 44ch; }
  .wk-empty .btn { margin-top: var(--space-3); }
  .win { position: absolute; left: 0; right: 0; background: var(--window); border-block: 1px solid var(--window-edge); }
  .win .free { position: absolute; left: 8px; top: 5px; font-size: var(--text-xs); font-weight: 600; color: var(--ink-2); }
  .col.off .win { background: transparent; border-color: var(--line); border-style: dashed; }
  .col .offtag { position: absolute; top: 12px; left: 8px; right: 8px; font-size: var(--text-xs); color: var(--ink-2); font-weight: 600; }
  .now { position: absolute; left: -1px; right: 0; height: 0; border-top: 1.5px solid var(--accent); z-index: 3; pointer-events: none; }
  .now::before { content: ""; position: absolute; left: -4px; top: -4.5px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

  .ses { position: absolute; left: 4px; right: 4px; z-index: 2; display: flex; flex-direction: column; gap: 3px; padding: 6px 8px; overflow: hidden; text-align: left;
    background: var(--surface); border: 1px solid var(--control-edge); border-radius: var(--radius-sm); color: var(--ink); cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out), outline-color var(--dur-fast) var(--ease-out); }
  .ses:hover, .ses.pressed { border-color: var(--ink-3); box-shadow: var(--shadow-sm); }
  .ses:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .ses .t { font-size: var(--text-xs); color: var(--ink-3); font-weight: 600; font-variation-settings: "wdth" 75; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ses .h { font-size: var(--text-sm); font-weight: 650; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .ses.tall .h { -webkit-line-clamp: 3; }
  .ses.short .h { -webkit-line-clamp: 1; }
  .ses .over { color: var(--ink); font-weight: 700; }
  .ses.short { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 2px 6px; padding: 3px 8px; }
  .ses.short .t { display: none; }
  .ses.short .h { flex: 1; min-width: 0; }
  .ses .mm { display: none; font-size: var(--text-xs); color: var(--ink-3); font-weight: 600; font-variation-settings: "wdth" 75; }
  .ses.short .mm { display: inline; }
  .ses.short .mix { flex-basis: 100%; order: 3; }
  .ses.today:not(.tall) .start { position: absolute; top: 5px; right: 5px; margin: 0; height: 22px; padding: 0 8px; font-size: var(--text-xs); }
  .ses.today:not(.tall) .t { padding-right: 52px; }
  .ses.today.short { padding-right: 60px; }
  .ses.today { border: 1.5px solid var(--accent); }
  .ses.today .t { color: var(--accent); }
  .ses .start { margin-top: auto; align-self: flex-start; }
  .ses.done { background: var(--surface-sunk); border-color: transparent; color: var(--ink-2); cursor: default; }
  .ses.done .h { display: flex; align-items: center; gap: 4px; font-weight: 600; font-size: var(--text-xs); }
  .ses.done .h .icon { width: 14px; height: 14px; color: var(--pass); flex: none; }
  .ses.mockses { border-color: transparent; }
  .ses.mockses .t, .ses.mockses .mm { color: var(--wall-ink-2); }
  .ses.mockses .mix .mock { background: var(--wall-ink); }
  .ses.mock-done .h { display: flex; align-items: center; gap: 4px; }
  .ses.mock-done .h .icon { width: 14px; height: 14px; color: var(--wall-pass); flex: none; }
  /* Moving: the block rides a transform (no layout per frame); the ghost previews the snapped slot and glides between slots. */
  .ses.lifted { z-index: 6; cursor: grabbing; box-shadow: var(--shadow-md); will-change: transform; transition: box-shadow var(--dur-fast) var(--ease-out); }
  .ses.kb-lifted { z-index: 6; box-shadow: var(--shadow-md); outline: 2px solid var(--focus); outline-offset: 2px; transition: transform 160ms var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
  .ghost-ses { position: absolute; left: 0; top: 0; z-index: 1; opacity: 0; border: 1.5px dashed var(--accent); border-radius: var(--radius-sm); background: color-mix(in srgb, var(--accent) 8%, transparent); pointer-events: none;
    transition: transform 120ms var(--ease-out), width 120ms var(--ease-out), opacity var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  .ghost-ses.on { opacity: 1; }
  .ghost-ses.bad { border-color: var(--fail); background: color-mix(in srgb, var(--fail) 8%, transparent); }
  .ghost-ses.bad .dragtip { color: var(--wall-fail); }
  @media (prefers-reduced-motion: reduce) { .ghost-ses, .ses.kb-lifted { transition: none; } }
  :root[data-motion="reduce"] .ghost-ses, :root[data-motion="reduce"] .ses.kb-lifted { transition: none; }
  .dragtip { position: absolute; left: 0; bottom: calc(100% + 6px); z-index: 7; padding: 4px 8px; border-radius: var(--radius-xs); font-size: var(--text-xs); font-weight: 650; white-space: nowrap; font-variant-numeric: tabular-nums; box-shadow: var(--shadow-md); pointer-events: none; }

  /* session inspector: docked right of the week grid; the grid narrows instead of being covered */
  .cal-split { display: grid; grid-template-columns: minmax(0, 1fr) 0px; transition: grid-template-columns 200ms var(--ease-out); }
  .cal-split.insp-open { grid-template-columns: minmax(0, 1fr) calc(360px + var(--space-4)); }
  .cal-main { min-width: 0; }
  @media (prefers-reduced-motion: reduce) { .cal-split { transition: none; } }
  :root[data-motion="reduce"] .cal-split { transition: none; }
  .pop { min-width: 0; overflow: clip; }
  .pop[hidden] { display: none; }
  .pop-in { position: sticky; top: calc(var(--topbar-h) + var(--space-3)); width: 360px; margin-left: var(--space-4); max-height: calc(100dvh - var(--topbar-h) - var(--space-6)); overflow: auto; overscroll-behavior: contain;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: var(--space-5); }
  .ses.is-open { outline: 2px solid var(--accent); outline-offset: 1px; z-index: 5; }
  .pop-head { display: flex; justify-content: space-between; gap: var(--space-3); align-items: flex-start; }
  .pop-head h3 { font-size: var(--text-md); }
  .pop-head p { font-size: var(--text-sm); color: var(--ink-3); margin-top: 2px; font-variant-numeric: tabular-nums; }
  .pop .mix { margin-top: var(--space-3); }
  .pop .items { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: grid; }
  .pop .item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px var(--space-3); padding: var(--space-3) 0; }
  .pop .item + .item { border-top: 1px solid var(--line); }
  .pop .item .ti { font-weight: 600; font-size: var(--text-sm); color: var(--ink); text-decoration: none; }
  .pop .item a.ti:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pop .item .m { font-size: var(--text-xs); color: var(--ink-3); font-weight: 600; font-variation-settings: "wdth" 75; padding-top: 2px; }
  .pop .item .reason { grid-column: 1 / -1; }
  .pop-sum { font-size: var(--text-xs); color: var(--ink-3); margin-top: var(--space-2); }
  .pop-foot { display: flex; gap: var(--space-2); margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--line); align-items: center; flex-wrap: wrap; }
  .pop-foot .btn-primary { margin-left: auto; }
  .pop .moveto { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .pop .moveto h4 { font-size: var(--text-sm); font-weight: 650; margin-bottom: var(--space-2); }
  .pop .moveto ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-1); max-height: 240px; overflow: auto; }
  .pop .moveto button { width: 100%; justify-content: flex-start; }
  .daymenu-pop { position: absolute; z-index: 30; min-width: 220px; }

  /* month */
  .month { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); padding: 0; overflow: clip; }
  .month .mh { padding: var(--space-2) var(--space-3); font-size: var(--text-xs); font-weight: 650; color: var(--ink-3); border-bottom: 1px solid var(--line); }
  .mc { min-height: 104px; padding: var(--space-2) var(--space-3); border-top: 1px solid var(--line); border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; min-width: 0; text-align: left; background: none; color: var(--ink); }
  .month .mc:nth-child(7n + 8) { border-left: 0; }
  .month .mh + .mc, .month .mc:nth-child(-n + 14) { border-top: 0; }
  .mc.out { background: var(--surface-sunk); color: var(--ink-3); }
  .mc .num { display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-variation-settings: "wdth" 75; font-variant-numeric: tabular-nums; font-size: var(--text-sm); }
  .mc .num small { font-size: var(--text-xs); color: var(--ink-3); font-weight: 600; }
  .mc.today .num > span:first-child { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--accent-fill); color: var(--on-accent); }
  .mc .what { font-size: var(--text-xs); color: var(--ink-2); line-height: 1.3; }
  .roadmap .mc { min-height: 84px; }
  .roadmap .mc .mix { margin-top: auto; }
  .roadmap-pick { margin-top: var(--space-3); }
  .roadmap-sum { margin: 0 0 var(--space-3); color: var(--ink-2); font-size: var(--text-sm); }
  .mc .chip { align-self: flex-start; display: inline-flex; align-items: center; gap: 5px; height: 20px; padding: 0 6px; border-radius: var(--radius-xs); font-size: var(--text-xs); font-weight: 650; font-variation-settings: "wdth" 75; }
  .mc .chip .icon { width: 12px; height: 12px; }
  .mc .chip.check { box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--ink-2); }
  .mc .chip.off { color: var(--ink-2); border: 1px dashed var(--control-edge); }
  .mc .chip.interview { background: var(--ink); color: var(--ground); }
  button.mc:hover { background: var(--surface-sunk); }

  /* agenda (phone) */
  .agenda { display: none; list-style: none; padding: 0; margin: 0; }
  .ag-day { margin-top: var(--space-5); }
  .ag-day:first-child { margin-top: 0; }
  .ag-day h3 { position: sticky; top: var(--topbar-h); z-index: 2; display: flex; justify-content: space-between; align-items: baseline; padding: var(--space-2) 0; background: var(--ground); font-size: var(--text-base); }
  .ag-day h3 small { font-size: var(--text-xs); color: var(--ink-3); font-weight: 600; font-variation-settings: "wdth" 75; }
  .ag-day.today h3 { color: var(--accent); }
  .ag-ses { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); width: 100%; text-align: left; margin-top: var(--space-2); color: var(--ink); }
  .ag-ses .t { font-size: var(--text-xs); font-weight: 650; color: var(--ink-2); font-variation-settings: "wdth" 75; font-variant-numeric: tabular-nums; padding-top: 2px; }
  .ag-ses .h { font-weight: 650; font-size: var(--text-sm); }
  .ag-ses .mix { margin-top: 6px; }
  .ag-ses .r { font-size: var(--text-xs); color: var(--ink-3); margin-top: 6px; }
  .ag-ses.today { border: 1.5px solid var(--accent); }
  .ag-ses.today .btn { margin-top: var(--space-3); width: 100%; }
  .ag-ses.mockses { border-color: transparent; }
  .ag-ses.mockses .t, .ag-ses.mockses .r { color: var(--wall-ink-2); }
  .ag-ses.done { background: var(--surface-sunk); border-color: transparent; color: var(--ink-2); }
  .ag-off, .ag-empty { margin-top: var(--space-2); padding: var(--space-3) var(--space-4); border: 1.5px dashed var(--control-edge); border-radius: var(--radius-md); font-size: var(--text-sm); color: var(--ink-2); }
  .ag-empty { border-style: solid; border-color: var(--line); }

  /* route: profile + forecast */
  .plan .route { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: var(--space-5); margin-top: var(--space-8); align-items: stretch; }
  .approach { padding: var(--space-5) var(--space-6) var(--space-4); display: flex; flex-direction: column; }
  .approach .section-head h2, .fc-panel h2, .you h2 { font-size: var(--text-base); }
  .approach .section-head { margin-bottom: var(--space-4); }
  /* The chart and its axis share one fixed summit column, so day labels sit under their bars. */
  .approach { --summit-w: 8.5rem; }
  .profile { position: relative; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)) var(--summit-w); align-items: end; flex: 1; min-height: 110px; max-height: 200px; }
  .pcol { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; border-radius: 4px; padding: 0; background: none; }
  .pcol:hover { background: var(--surface-sunk); }
