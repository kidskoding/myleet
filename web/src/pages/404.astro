---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { ROUTES } from "../lib/routes";
---

<Base title="Page not found" noindex description="There's no page at this address">
  <div class="page page-narrow">
    <section class="panel state-note" role="status">
      <Icon name="map" />
      <h1 style="font-size:var(--text-lg)">There's no page at this address</h1>
      <p>The link may be old or mistyped. Today has your next problem, and Learn has every module and note.</p>
      <div class="actions"><a class="btn btn-primary" href={ROUTES.today}>Go to Today</a><a class="btn btn-ghost" href={ROUTES.learn}>Open Learn</a></div>
    </section>
  </div>
</Base>
