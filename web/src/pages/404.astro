---
import Base from "../layouts/Base.astro";
import { ROUTES } from "../lib/routes";
---

<Base title="Page not found" noindex description="There's no page at this address">
  <div class="page">
    <section class="gate" role="status">
      <h1>There's no page at this address</h1>
      <p class="lede">The link may be old or mistyped. Today has your next problem, and Learn has every module and note.</p>
      <div class="gate-actions"><a class="btn btn-primary btn-lg" href={ROUTES.today}>Go to Today</a><a class="link" href={ROUTES.learn}>Open Learn</a></div>
    </section>
  </div>
</Base>
