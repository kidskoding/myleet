---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { ROUTES } from "../lib/routes";
import type { IconName } from "../lib/ui/icons";

// The same icons as the top bar, so each way out reads as the tab it opens
const places: { href: string; icon: IconName; title: string; line: string }[] = [
  { href: ROUTES.today, icon: "sunrise", title: "Today", line: "Your next problem and the reviews due" },
  { href: ROUTES.learn, icon: "map", title: "Learn", line: "Eighteen modules, each with notes and problems" },
  { href: ROUTES.companies, icon: "building-2", title: "Companies", line: "Practice sets for the company you're interviewing with" },
  { href: ROUTES.mock, icon: "timer", title: "Mock", line: "A timed round with hints and labels hidden" },
];
---

<Base title="Page not found" noindex description="There's no page at this address">
  <div class="page nf">
    <section class="gate" role="status">
      <h1>There's no page at this address</h1>
      <p class="lede">The link may be old or mistyped. Today has your next problem, and Learn has every module and note</p>
      <div class="gate-actions"><a class="btn btn-primary btn-lg" href={ROUTES.today}>Go to Today</a><a class="link" href={ROUTES.learn}>Open Learn</a></div>
    </section>
    <nav aria-label="Where to go instead">
      <ul class="nf-list">
        {places.map((p) => (
          <li><a href={p.href}><Icon name={p.icon} /><span><strong>{p.title}</strong><span>{p.line}</span></span></a></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .nf { display: grid; gap: var(--space-10); align-items: start; }
  .nf-list { list-style: none; margin: 0; padding: 0; }
  .nf-list li + li { border-top: 1px solid var(--line); }
  .nf-list a { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--space-4); align-items: start; padding: var(--space-4) var(--space-3); margin-inline: calc(-1 * var(--space-3)); border-radius: var(--radius-sm); text-decoration: none; color: var(--ink); transition: background-color var(--dur-fast) var(--ease-out); }
  .nf-list a:hover { background: color-mix(in srgb, var(--ctp-text) 5%, transparent); }
  .nf-list a :global(.icon) { width: 18px; height: 18px; margin-top: 2px; color: var(--ink-3); }
  .nf-list strong { display: block; font-weight: 650; }
  .nf-list span span { display: block; margin-top: 2px; font-size: var(--text-sm); color: var(--ink-2); }
  @media (min-width: 1000px) {
    .nf { grid-template-columns: minmax(0, 1fr) 380px; gap: var(--space-16); padding-top: var(--space-8); }
  }
</style>
