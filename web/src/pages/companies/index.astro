---
import "../../components/companies/companies.css";
import Base from "../../layouts/Base.astro";
import { buildCatalog } from "../../lib/build-catalog";
import { companySlug } from "../../lib/catalog";
import { companyHref } from "../../lib/routes";
import { icon } from "../../lib/ui/icons";
import type { PlaylistGroup } from "../../lib/types";

const c = buildCatalog();
const GROUPS: { name: PlaylistGroup; about: string }[] = [
  { name: "Big tech", about: "FAANG-style DSA loops." },
  { name: "Little tech", about: "Product companies that still run LeetCode-style rounds." },
  { name: "AI labs / high growth", about: "Private, AI-forward and fast-growing companies." },
  { name: "Quant", about: "Trading-firm interview track." },
  { name: "Fortune 500", about: "Banks, retail, health and industrial tech teams." },
];
const groups = GROUPS.map((g) => ({ ...g, sets: c.playlists.filter((p) => p.group === g.name) }));
const total = c.playlists.length;
const gid = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<Base title="Companies" nav="companies" description={`${total} curated company practice sets, most asked problems first. Pin the companies you're interviewing with and your plan mixes their problems in.`}>
  <div class="page cos" data-cos="index">
    <div class="head">
      <div>
        <h1>Companies</h1>
        <p>{total} curated practice sets, one per company, with the most asked problems first. Pin the companies you're interviewing with and your plan mixes their problems in.</p>
      </div>
      <label class="find"><Fragment set:html={icon("search").value} /><input type="search" aria-label="Find a company" placeholder="Find a company" data-find autocomplete="off" /><kbd>/</kbd></label>
    </div>

    <section class="pinned" aria-labelledby="pn" data-pinned hidden>
      <div class="section-head"><h2 id="pn">Your companies</h2><span class="meta">Pinned to your plan</span></div>
      <ul class="panel pin-list" data-pin-list></ul>
    </section>
    <p class="pin-empty" data-pin-empty>Pin a company and your plan mixes its problems in. Most people pin one to three.</p>

    <section class="groups" aria-label="All companies" data-view="all">
      <div class="tabs" role="tablist" aria-label="Group">
        <button type="button" role="tab" aria-selected="true" data-group="all">All <span class="count">{total}</span></button>
        {groups.map((g) => <button type="button" role="tab" aria-selected="false" data-group={gid(g.name)}>{g.name} <span class="count">{g.sets.length}</span></button>)}
      </div>
      {
        groups.map((g) => (
          <section class="grp-sec" aria-labelledby={`g-${gid(g.name)}`} data-grp={gid(g.name)}>
            <h2 id={`g-${gid(g.name)}`}>{g.name} <span>{g.sets.length} sets</span></h2>
            <p>{g.about}</p>
            <ul class="co-grid">
              {g.sets.map((p) => (
                <li data-name={p.title.toLowerCase()}>
                  <a class="co" href={companyHref(p.id)} data-co={companySlug(p.id)}>
                    <span class="cname">{p.title}</span>
                    <div class="bar" aria-hidden="true" data-co-bar></div>
                    <span class="cnt">{p.entries.length}</span>
                  </a>
                </li>
              ))}
            </ul>
            {g.sets.length > 9 && <button type="button" class="btn btn-ghost btn-sm more" data-group={gid(g.name)}>All {g.sets.length} {g.name} sets</button>}
          </section>
        ))
      }
    </section>
    <section class="panel state-note" data-search-empty hidden role="status" style="margin-top:var(--space-8)"></section>
  </div>
</Base>

<script>
  import "../../scripts/companies";
</script>
