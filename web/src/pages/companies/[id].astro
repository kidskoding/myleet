---
import TrackCta from "../../components/TrackCta.astro";
import { chevronRight } from "../../components/learn/icons";
import "../../components/companies/companies.css";
import { setRow, SET_FOLD } from "../../components/companies/rows";
import Base from "../../layouts/Base.astro";
import { buildCatalog } from "../../lib/build-catalog";
import { companySlug } from "../../lib/catalog";
import { companyLogo } from "../../lib/company-logos";
import { problemHref, ROUTES } from "../../lib/routes";
import { icon } from "../../lib/ui/icons";
import type { Playlist } from "../../lib/types";

export function getStaticPaths() {
  return buildCatalog().playlists.map((playlist) => ({ params: { id: companySlug(playlist.id) }, props: { playlist } }));
}

interface Props {
  playlist: Playlist;
}

const { playlist: p } = Astro.props;
const c = buildCatalog();
const slug = companySlug(p.id);
const n = p.entries.length;
// Topics in the order the sourced focus line names them, plus the set's first (most reported) problem.
const TOPICS: [RegExp, string][] = [
  [/graph|bfs|dfs|topolog|shortest path/i, "graphs"], [/tree/i, "trees"], [/dynamic programming|\bdp\b/i, "dynamic programming"],
  [/sliding window/i, "sliding window"], [/stack|queue/i, "stacks"], [/heap|priority/i, "heaps"], [/interval/i, "intervals"],
  [/binary search/i, "binary search"], [/linked list/i, "linked lists"], [/\btrie/i, "tries"], [/backtrack/i, "backtracking"],
  [/greedy/i, "greedy problems"], [/\bbit/i, "bit manipulation"], [/two pointer/i, "two pointers"], [/design/i, "data-structure design"],
  [/simulat/i, "simulation"], [/pars/i, "parsing"], [/hash|array|string/i, "arrays and strings"],
];
// Only the live-coding half (before ";") feeds the lead; the online-assessment half is secondary.
const focus = (p.focus ?? "").split(";")[0] ?? "";
const topics = TOPICS.map(([re, label]) => ({ label, at: focus.search(re) }))
  .filter((t) => t.at >= 0)
  .sort((a, b) => a.at - b.at)
  .slice(0, 3)
  .map((t) => t.label);
const list = new Intl.ListFormat("en", { type: "conjunction" }).format(topics).replace(", and ", " and ");
// The example is the most distinctive of the set's first ten problems: the one the fewest
// other company sets share, so pages don't all say "Two Sum".
const shared = new Map<number, number>();
for (const set of c.playlists) for (const e of set.entries) if (e.problem !== null) shared.set(e.problem, (shared.get(e.problem) ?? 0) + 1);
const lead10 = p.entries.slice(0, 10).flatMap((e) => (e.problem === null ? [] : [e.problem]));
const pick = lead10.reduce<number | undefined>((best, i) => (best === undefined || (shared.get(i) ?? 0) < (shared.get(best) ?? 0) ? i : best), undefined);
const example = pick !== undefined ? c.problems[pick] : undefined;
---

<Base title={`${p.title} prep`} nav="companies" description={`A curated ${p.title} practice set of ${n} problems, most asked first, with the techniques it leans on. Not a list of actual interview questions.`}>
  <div class="page cos" data-cos="prep" data-playlist={p.id} data-slug={slug}>
    <nav class="crumbs" aria-label="Breadcrumb"><a href={ROUTES.companies}>Companies</a><Fragment set:html={chevronRight().value} /><span>{p.group}</span></nav>
    <div class="prep-head">
      <div>
        <h1 class="co-title"><Fragment set:html={companyLogo(slug).value} />{p.title}</h1>
        {topics.length > 0 && (
          <p class="lead">
            {p.title}'s interviews mostly cover {list}
            {example && <>, with problems like <a href={problemHref(example.id)}><strong>{example.title}</strong></a></>}
          </p>
        )}
      </div>
      <div>
        <div class="actions">
          <a class="btn btn-secondary" href={`${ROUTES.mock}?company=${slug}`} aria-keyshortcuts="m"><Fragment set:html={icon("timer").value} />{p.title} mock</a>
          <button class="btn btn-primary when-in" type="button" data-pin aria-pressed="false" aria-keyshortcuts="p">Pin to your plan</button>
        </div>
        <p class="pinned-note" data-pinned-note hidden></p>
        <TrackCta detail="Your account shows how ready you are for this set and can add it to your plan" />
      </div>
    </div>

    <div class="prep-grid">
      <section aria-labelledby="ps">
        <div class="set-tools">
          <h2 id="ps">Practice problems</h2>
          <div class="seg when-in" role="group" aria-label="Show" data-set-seg>
            <button type="button" aria-pressed="true" data-show="all">All<span class="n">{n}</span></button>
            <button type="button" aria-pressed="false" data-show="notready">Not ready<span class="n" data-n="notready"></span></button>
            <button type="button" aria-pressed="false" data-show="due">Due<span class="n" data-n="due"></span></button>
          </div>
        </div>
        <ol class="panel set queue" aria-label={`${p.title} practice set, most asked first`} data-set>
          <Fragment set:html={p.entries.map((e, i) => setRow(c, e, i + 1).value).join("")} />
        </ol>
        {n > SET_FOLD && <button type="button" class="btn btn-ghost more" data-show-all aria-expanded="false">Show all {n}</button>}
        <p class="set-foot" data-set-foot hidden></p>
      </section>
      <aside data-aside>
        <section class="panel readiness when-in" aria-labelledby="rd" data-readiness>
          <h2 id="rd">Readiness</h2>
          <div class="skel" style="height:44px;width:60%;margin-top:12px"></div>
          <div class="skel" style="height:8px;margin-top:12px"></div>
        </section>
        <section class="panel leans" aria-labelledby="ln" data-leans>
          <h2 id="ln">Techniques in this set</h2>
          <p class="text-small text-muted" style="margin-top:var(--space-1)">The techniques covered by this set and your progress in each</p>
          <div class="skel" style="height:80px;margin-top:12px"></div>
        </section>
        <section class="panel inplan when-in" aria-labelledby="ip" data-inplan hidden></section>
      </aside>
    </div>
  </div>
</Base>

<script>
  import "../../scripts/companies";
</script>
