---
import "@fontsource-variable/literata/opsz.css";
import Base from "../layouts/Base.astro";
import "../components/flow.css";
---

<Base title="Find your level" shell="focused" description="Code two or three real interview problems, after a quick pattern warm-up, to see which patterns you know and where to start. Free, about 15 minutes, no account needed">
  <div class="flow" data-diagnostic>
    <div class="steps"><span class="count skel" style="width:120px;height:18px"></span></div>
    <div class="q"><div class="skel" style="height:44px;width:70%"></div><div class="skel" style="height:22px;width:85%;margin-top:16px"></div></div>
  </div>
</Base>

<style is:global>
  .flow .dq-problem { margin-top: var(--space-6); padding: var(--space-5) var(--space-6); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .flow .dq-problem .head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .flow .dq-problem h2 { font-size: var(--text-lg); letter-spacing: -0.01em; }
  .flow .dq-problem .statement { margin-top: var(--space-3); font-family: var(--font-read); font-size: var(--text-base); line-height: 1.6; color: var(--ink-2); max-width: 68ch; }
  .flow .dq-problem .statement p + p { margin-top: var(--space-3); }
  .flow .dq-problem .statement code { font-size: 0.9em; }
  .flow .dq-problem .lc { display: inline-block; margin-top: var(--space-3); font-size: var(--text-sm); }
  .flow .options.dq { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .flow .options.dq .opt { grid-template-columns: auto 1fr auto; }
  .flow .options.dq .opt strong { grid-row: span 2; }
  .flow .dk { margin-left: auto; }
  /* Results: a wider page with the verdict as a mesh, a split bar and the save card beside it */
  .flow.is-results { max-width: var(--content-max); overflow-x: clip; }
  .flow .dres { margin-top: var(--space-6); display: grid; grid-template-columns: minmax(0, 1fr) 360px; column-gap: var(--space-12); align-items: start; }
  .flow .dres > * { grid-column: 1; }
  .flow .dres > .save { grid-column: 2; grid-row: 1 / span 4; position: sticky; top: calc(var(--topbar-h) + var(--space-6)); }
  .flow .dres-head { position: relative; isolation: isolate; padding-bottom: var(--space-4); }
  .flow .dres-head .mesh { inset: -80px -6vw -40px; --ax: 12%; --ay: 30%; --bx: 46%; --by: 18%; --cx: 78%; --cy: 50%; }
  .flow .dres h1 { font-size: var(--text-num-xl); font-weight: 740; letter-spacing: var(--track-display); line-height: 1; font-variation-settings: "wdth" 84; }
  .flow .dres .sub { margin-top: var(--space-4); color: var(--ink-2); font-size: 1.125rem; max-width: 52ch; line-height: 1.5; }
  .flow .split { display: flex; gap: 3px; height: 10px; margin-top: var(--space-8); max-width: 560px; }
  .flow .split span { border-radius: var(--radius-pill); }
  .flow .split .strong { background: var(--pass-solid); } .flow .split .shaky { background: var(--due-solid); } .flow .split .start { background: var(--accent); }
  .flow .split-key { list-style: none; padding: 0; margin-top: var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); color: var(--ink-2); font-size: var(--text-sm); }
  .flow .split-key li { display: flex; align-items: baseline; gap: var(--space-2); }
  .flow .split-key .num { font-family: var(--font-label); font-size: 1.75rem; font-weight: 650; letter-spacing: var(--track-num); color: var(--ink); }
  .flow .save { padding: var(--space-6); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .flow .save .btn { white-space: normal; height: auto; min-height: var(--h, 44px); padding-block: var(--space-2); line-height: 1.3; text-align: center; }
  .flow .save h2 { font-size: var(--text-md); font-weight: 700; letter-spacing: -0.02em; }
  .flow .save p { color: var(--ink-2); font-size: var(--text-sm); }
  .flow .save .fine { color: var(--ink-3); font-size: var(--text-xs); }
  .flow .dres-sec { margin-top: var(--space-10); }
  .flow h2.sec { font-size: var(--text-sec); font-weight: 650; letter-spacing: -0.01em; }
  .flow .topics { margin-top: var(--space-3); list-style: none; padding: 0; }
  .flow .topics li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 2px var(--space-4); align-items: center; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .flow .topics li:last-child { border-bottom: 1px solid var(--line); }
  .flow .topics .mod-chip { grid-row: 1 / span 2; align-self: start; margin-top: 2px; }
  .flow .topics .name { font-weight: 600; }
  .flow .topics .src { grid-column: 2; font-size: var(--text-sm); color: var(--ink-3); }
  .flow .topics .tag { grid-row: 1 / span 2; grid-column: 3; }
  .flow .start-at { padding-top: var(--space-2); }
  .flow .start-at h2 { font-size: var(--text-md); }
  @media (max-width: 1000px) {
    .flow .dres { grid-template-columns: minmax(0, 1fr); }
    /* the save card becomes a sticky bar with its one button (last in the page, so it sticks to the bottom) */
    .flow .dres > .save { grid-column: 1; grid-row: auto; top: auto; margin-top: var(--space-6); }
    /* the save bar is the one sticky action here, so "Take it again" stays in the page */
    .flow .dres .next { position: static; padding: 0; margin-top: var(--space-6); background: none; border: 0; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .flow .save { position: sticky; bottom: calc(var(--space-3) + env(safe-area-inset-bottom)); z-index: 2; grid-template-columns: minmax(0, 1fr) auto; align-items: center; padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4); }
    .flow .save :is(p, .fine) { display: none; }
    .flow .save h2 { font-size: var(--text-base); }
    .flow .save .btn { --h: 44px; padding: 0 var(--space-4); font-size: var(--text-sm); }
    .flow .dres h1 { font-size: 2.5rem; }
  }
  .flow .start-at p { margin-top: var(--space-2); color: var(--ink-2); font-size: var(--text-sm); max-width: 62ch; }
  .flow .start-at .tech { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .flow .start-at ol { margin-top: var(--space-3); padding-left: 1.2em; display: grid; gap: var(--space-1); font-size: var(--text-sm); }
  @media (max-width: 760px) {
    .flow .options.dq { grid-template-columns: minmax(0, 1fr); }
    .flow .dq-problem { padding: var(--space-4); }
  }
</style>

<script>
  import "../scripts/diagnostic";
</script>
