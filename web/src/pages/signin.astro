---
import Base from "../layouts/Base.astro";
---

<Base title="Sign up or sign in" shell="focused" description="Create a free myleet account to keep your study plan, get reviews on the right day and sync progress across devices">
  <div class="signin-page">
    <div class="panel auth-panel" data-signin-page aria-live="polite">
      <h1 id="si-h" class="visually-hidden">Sign up or sign in</h1>
      <div class="auth-stack" aria-hidden="true">
        <span class="skel" style="height:28px;width:70%"></span>
        <span class="skel" style="height:40px"></span>
        <span class="skel" style="height:44px;margin-top:var(--space-4)"></span>
      </div>
    </div>
  </div>
</Base>

<style>
  .signin-page { max-width: 480px; margin: 0 auto; padding: var(--space-12) var(--gutter) var(--space-16); }
  @media (max-width: 760px) { .signin-page { padding-top: var(--space-6); } }
</style>

<script>
  import { AUTH_ERRORS, fetchMe } from "../lib/account";
  import { afterSignIn } from "../lib/gate";
  import { readPrefs } from "../lib/prefs";

  async function init(): Promise<void> {
    const el = document.querySelector<HTMLElement>("[data-signin-page]");
    if (!el) return;
    const params = new URLSearchParams(location.search);
    const code = params.get("auth_error");
    const me = await fetchMe();
    if (me && !code) {
      location.replace(afterSignIn(me, params.get("next"), readPrefs().plan.onboarded));
      return;
    }
    const { mountSignInPage } = await import("../scripts/auth-ui");
    await mountSignInPage(el, code === null ? undefined : (AUTH_ERRORS[code] ?? "Sign-in didn't finish. Try again or use another method"));
  }
  document.addEventListener("astro:page-load", () => void init());
</script>
