---
import "@fontsource-variable/archivo/wdth.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import TabBar from "../components/shell/TabBar.astro";
import TopBar, { type NavKey } from "../components/shell/TopBar.astro";
import { flavorTokens, THEME_BOOT } from "../lib/flavors";
import "@catppuccin/palette/css/catppuccin.css";
import "../styles/flavors.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";

interface Props {
  title: string;
  description?: string;
  /**
   * app: top bar + phone tab bar. focused: brand and theme only (onboarding, sign-in).
   * public: top bar without the tab bar (landing, legal, public profile).
   * bare: no chrome (the workspace draws its own bar); overlays and keys still work.
   */
  shell?: "app" | "focused" | "public" | "bare";
  nav?: NavKey;
  /** Signed-in and personal pages stay out of search results. */
  noindex?: boolean;
  /** Absolute or root-relative 1200x630 image. */
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = "Practice data structures and algorithms for coding interviews. Run tests in your browser and review problems on a schedule",
  shell = "app",
  nav,
  noindex = false,
  ogImage = "/og/default.png",
  ogType = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://myleet.dev");
const fullTitle = title === "myleet" ? title : `${title} · myleet`;
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL(ogImage, site).href;
const night = flavorTokens("mocha").ground;
const chrome = shell === "app" || shell === "public" || shell === "focused";
---

<!doctype html>
<html lang="en" data-flavor="mocha" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="myleet" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content={night} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <!-- Before first paint: flavor, accent, in-app reduced motion and the signed-in flag, so nothing flashes. -->
    <script is:inline set:html={THEME_BOOT} />
    <ClientRouter fallback="swap" />
  </head>
  <body data-shell={shell} data-nav={nav} class={shell === "app" ? "has-tabbar" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    {chrome && <TopBar nav={nav} />}
    <div id="banners" class="banners" aria-label="Notices"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    {shell === "app" && <TabBar nav={nav} />}
    <div id="toasts" class="toast-region" role="status" aria-live="polite"></div>
    <script>
      import "../scripts/shell";
    </script>
  </body>
</html>
