# Maintainer: Anirudh <kidskoding>
pkgname=myleet-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Adaptive LeetCode practice in your terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/kidskoding/myleet"
license=('MIT')
depends=('git')
optdepends=('uv: python env for problem tests (auto-synced on first launch)')
provides=('myleet')
conflicts=('myleet')
source_x86_64=(
  "myleet_${pkgver}_linux_amd64.tar.gz::${url}/releases/download/v${pkgver}/myleet_${pkgver}_linux_amd64.tar.gz"
)
source_aarch64=(
  "myleet_${pkgver}_linux_arm64.tar.gz::${url}/releases/download/v${pkgver}/myleet_${pkgver}_linux_arm64.tar.gz"
)
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 myleet "${pkgdir}/usr/bin/myleet"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/myleet/README.md"
}
